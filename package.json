{
  "name": "menulens",
  "version": "1.0.0",
  "description": "MenuLens - AI Menu Scanner",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:ocr": "cross-env OLLAMA_REFINE=0 OLLAMA_VISION=0 OLLAMA_CLEAN=0 npx tsx test_batch.ts",
    "test:splitter": "cross-env PYTHONPATH= npx tsx test_splitter.ts",
    "test:units": "cross-env PYTHONPATH= npx tsx test_units.ts",
    "test": "npm run test:units && npm run test:splitter && npm run test:ocr",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "^3.1.0",
    "framer-motion": "^12.43.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.28.0",
    "next": "^15.5.22",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postcss": "^8.5.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "shadcn": "^4.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
