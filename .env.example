# ── MenuLens environment variables ────────────────────────────────
# Copy to .env.local and fill in. Only AI/vision/image features need
# real keys; OCR and core scanning work without them.
# NEVER commit .env.local.

# ── AI chat providers (fallback chain: OpenRouter → Groq → Gemini → …) ──
OPENROUTER_API_KEY=        # https://openrouter.ai/keys — primary AI provider
GROQ_API_KEY=              # https://console.groq.com/keys — fast, cheap fallback
GEMINI_API_KEY=            # https://aistudio.google.com/apikey — Google fallback
SAMBANOVA_API_KEY=         optional
FREETHEAI_API_KEY=         optional
HF_TOKEN=                  optional (HuggingFace)
GITHUB_TOKEN=              optional (GitHub Models)
CLOUDFLARE_API_TOKEN=      optional
CLOUDFLARE_ACCOUNT_ID=     required only if using Cloudflare provider

# ── Dish image search ──────────────────────────────────────────
UNSPLASH_ACCESS_KEY=       # https://unsplash.com/developers
PEXELS_API_KEY=            # https://www.pexels.com/api/
BING_API_KEY=              # https://www.microsoft.com/en-us/bing/apis/bing-image-search-api

# ── Nutrition ──────────────────────────────────────────────────
USDA_API_KEY=              # https://fdc.nal.usda.gov/api-key-signup.html (falls back to DEMO_KEY)

# ── Python OCR (Layer 3) ──────────────────────────────────────
# Optional — only needed if you want the enhanced pytesseract pipeline.
# The project .venv python is auto-detected when it exists (fallback chain:
# MENULENS_PYTHON → .venv/Scripts/python.exe → PYTHON_CMD → python on PATH).
PYTHON_CMD=python          # python executable for the OCR subprocess
PYTHON_SITE_PACKAGES=      # site-packages path for pytesseract/PIL/numpy/scipy (auto-detected if empty)
TESSERACT_CMD=tesseract    # tesseract binary path (auto-resolves to the standard install location if unset)

# ── Ollama (local LLM for OCR refinement + text cleaning) ──────
# Set OLLAMA_URL to your Ollama server URL (default: http://localhost:11434).
# Set OLLAMA_MODEL to override the default model (default: gemma4:e2b).
# Set OLLAMA_REFINE=0 to disable dish refinement (deterministic only).
# Set OLLAMA_VISION=0 to disable vision rescue (direct image OCR).
# Set OLLAMA_CLEAN=0 to disable text cleaning (deterministic only, for regression harness).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_REFINE=
OLLAMA_VISION=
OLLAMA_CLEAN=

# ── Misc ───────────────────────────────────────────────────────
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=          # generate with: openssl rand -base64 32
LOG_LEVEL=info             # pino log level (trace|debug|info|warn|error)